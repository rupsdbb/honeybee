# Copy to .env and adjust. Every option can also be passed as a --flag (see `honeybee --help`).

# Your Electrum server: tcp://host:port (plain) or ssl://host:port (TLS stream).
HONEYBEE_ELECTRUM=ssl://electrs.home:50002
# For a self-signed or private-CA certificate (e.g. mkcert), trust it explicitly:
# HONEYBEE_ELECTRUM_CA_FILE=/etc/honeybee/rootCA.pem
# Or, only on a network you trust, skip certificate verification:
# HONEYBEE_ELECTRUM_INSECURE=true

# bitcoin (mainnet), testnet, testnet4, signet or regtest
HONEYBEE_NETWORK=bitcoin

HONEYBEE_LISTEN=0.0.0.0:8585
HONEYBEE_DATA_DIR=/data

# Required unless listening on localhost. Generate with:
#   PW=$(openssl rand -base64 18); echo "Password: $PW"; echo "$PW" | honeybee hash-password; unset PW
# (prints a random password to log in with, then the hash to put here)
# Note: in docker compose files and .env, a literal "$" must be written as "$$".
HONEYBEE_PASSWORD_HASH=

# Set when served over HTTPS (e.g. behind a reverse proxy):
# HONEYBEE_SECURE_COOKIE=true

# Links to your own block explorer (e.g. a mempool instance). Unset = no links.
# HONEYBEE_EXPLORER_URL=http://mempool.home

# HONEYBEE_GAP_LIMIT=20
# HONEYBEE_LOG=info
